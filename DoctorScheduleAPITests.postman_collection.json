{
	"info": {
		"_postman_id": "YOUR_COLLECTION_ID",
		"name": "Doctor Schedule API Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Login as Doctor",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Token is present\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.token).to.not.be.empty;",
							"    pm.collectionVariables.set(\"authToken\", jsonData.token);",
							"    pm.collectionVariables.set(\"doctorId\", jsonData.user.userId); // Assuming userId from login is the doctorId for schedule",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"bstuan@luanvan.com\",\n    \"password\": \"bstuan\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Doctor Schedule by ID",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{authToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/doctor-schedules/doctor/{{doctorId}}?startDate=2025-06-01&endDate=2025-06-30",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"doctor-schedules",
						"doctor",
						"{{doctorId}}"
					],
					"query": [
						{
							"key": "startDate",
							"value": "2025-06-01"
						},
						{
							"key": "endDate",
							"value": "2025-06-30"
						}
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:9090" 
		},
		{
			"key": "authToken",
			"value": ""
		},
		{
			"key": "doctorId",
			"value": ""
		}
	]
}
